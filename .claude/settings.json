{
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo test:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo deny check:*)",
      "Bash(just check)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)"
    ],
    "deny": [
      "Read(**/chat-cli-keys)",
      "Read(**/chat-cli-keys/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
